# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/trip-planner
# 프로덕션: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trip-planner

# Auth
JWT_SECRET=your_jwt_secret_key

# CORS (프로덕션: Vercel 배포 URL 입력, 여러 개면 콤마로 구분)
# CORS_ORIGIN=https://your-app.vercel.app

# API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
ODSAY_API_KEY=your_odsay_api_key
SEOUL_BUS_API_KEY=your_seoul_bus_api_key
ITS_API_KEY=your_its_api_key
